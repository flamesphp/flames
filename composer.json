{
  "name": "flamesphp/flames",
  "description": "The skeleton application for the Flames framework.",
  "authors": [
    {
      "name": "Gabriel 'Kazz' Morgado",
      "email": "kazzxd1@gmail.com"
    }
  ],
  "keywords": [
    "flames",
    "framework"
  ],
  "license": "MIT",
  "type": "project",
  "minimum-stability": "dev",
  "require": {
    "php": "^8.3",
    "flamesphp/framework": "^1.0"
  },
  "scripts": {
    "setup":  ["vendor/flames/framework/bin install --setup"],
    "post-create-project-cmd":  [
      "composer install",
      "vendor/flames/framework/bin install --post-create-project-cmd"
    ],
    "post-package-install": ["vendor/flames/framework/bin install --post-package-install"],
    "post-install-cmd": ["vendor/flames/framework/bin install --post-install-cmd"],
    "post-update-cmd":  ["vendor/flames/framework/bin install --post-update-cmd"],
  }
}
